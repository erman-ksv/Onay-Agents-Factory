# Explicit provider: gemini, openai or openrouter. Blank prefers Gemini, then OpenAI, then OpenRouter.
AGENT_FACTORY_PROVIDER=
# AI provider credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# Optional OpenAI model; blank uses the SDK default.
OPENAI_MODEL=
# OpenRouter secret comes from Codespaces Secrets, never commit a real value.
OPENROUTER_API_KEY=
# Only openrouter/free or a concrete model ending with :free are allowed.
OPENROUTER_MODEL=openrouter/free
# GitHub integration and automation (keep secrets out of Git)
GITHUB_TOKEN=
# Canonical application repository.
ONAY_REPOSITORY=erman-ksv/Onay

AGENT_ALLOWED_REPOSITORIES=erman-ksv/Onay,erman-ksv/Onay-Agents-Factory
# Optional: required before generated changes may edit .github/workflows or .github/actions
AGENT_FACTORY_ALLOW_WORKFLOW_CHANGES=

