# Explicit provider: gemini, openai, openrouter or groq. Blank prefers Gemini, then OpenAI, then OpenRouter.
AGENT_FACTORY_PROVIDER=
# AI provider credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# Optional OpenAI model; blank uses the SDK default.
OPENAI_MODEL=
# OpenRouter secret comes from Codespaces Secrets, never commit a real value.
OPENROUTER_API_KEY=
# Only openrouter/free or a concrete model ending with :free are allowed.
OPENROUTER_MODEL=openrouter/free
# GitHub integration and automation (keep secrets out of Git)
GITHUB_TOKEN=
# Canonical application repository.
ONAY_REPOSITORY=erman-ksv/Onay

AGENT_ALLOWED_REPOSITORIES=erman-ksv/Onay,erman-ksv/Onay-Agents-Factory
# Optional: required before generated changes may edit .github/workflows or .github/actions
AGENT_FACTORY_ALLOW_WORKFLOW_CHANGES=



# Groq is used only with explicit AGENT_FACTORY_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Local limits for each run. Input estimates use ceil(UTF-8 request bytes / 3)
# plus framing, including tool schemas/history; output is capped and reserved.
# This heuristic is not a tokenizer guarantee. A separate exact byte cap applies.
# Share one budget across Commander, Coder and specialists. No automatic waiting,
# retries, task replay or provider fallback after a budget failure / HTTP 429.
# A rejected request / HTTP 429 stops every client sharing that run's budget.
# Tune below your account/model limits; these values do not discover remote quota.
GROQ_CONTEXT_BUDGET_TOKENS=6000
GROQ_RUN_BUDGET_TOKENS=16000
GROQ_TPM_BUDGET_TOKENS=6000
GROQ_RESERVED_OUTPUT_TOKENS=512
GROQ_MAX_REQUEST_BYTES=24000


# Temporary host opt-out; unset/true restores legal specialist.
AGENT_FACTORY_LEGAL_ENABLED=false
